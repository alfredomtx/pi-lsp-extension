{
  "name": "pi-lsp-extension",
  "version": "1.2.1",
  "type": "module",
  "description": "Pi coding agent extension for LSP (Language Server Protocol) integration",
  "keywords": [
    "pi-package",
    "extension"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samfoy/pi-lsp-extension"
  },
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "tsc --noEmit",
    "mcp": "tsx ./src/mcp-server.ts",
    "activix:run": "node ./scripts/activix-run-summary.mjs"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vue/language-server": "^3.3.3",
    "intelephense": "^1.18.4",
    "tree-sitter-wasms": "^0.1.13",
    "typescript-language-server": "^5.3.0",
    "vscode-languageserver-protocol": "^3.17.5",
    "web-tree-sitter": "^0.24.7"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
